{
  "name": "@gogilo2003/web-search",
  "version": "1.0.0",
  "description": "TypeScript web search CLI built on DuckDuckGo with detailed extraction of the top results",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "web-search": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "start": "node dist/cli.js",
    "help": "tsx src/cli.ts --help",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "duckduckgo",
    "search",
    "cli",
    "typescript"
  ],
  "license": "MIT",
  "dependencies": {
    "cheerio": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
